            "ticker",
            "side",
            "quantity",
            "price",
            "value",
            "confidence",
            "reasoning",
        ]

        return pd.DataFrame(trades, columns=columns)
    except Exception:
        return pd.DataFrame()


def load_equity_dataframe():
    try:
        history = get_equity_history()

        if not history:
            return pd.DataFrame()

        rows = []

        for row in history:
            if len(row) >= 4:
                rows.append(
                    {
                        "Timestamp": row[1],
                        "Equity": safe_float(row[3]),
                    }
                )

        df = pd.DataFrame(rows)

        if not df.empty:
            df["Timestamp"] = pd.to_datetime(
                df["Timestamp"],
                errors="coerce",
            )
            df = df.dropna(subset=["Timestamp"])
            df = df.set_index("Timestamp")

        return df
    except Exception:
        return pd.DataFrame()


