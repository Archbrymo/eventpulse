PIPELINE_FILE = Path(".eventpulse_pipeline.json")


def load_pipeline():
    if not PIPELINE_FILE.exists():
        return {}

    try:
        return json.loads(PIPELINE_FILE.read_text())
    except Exception:
        return {}


def money(value):
    try:
        return f"${float(value):,.2f}"
    except Exception:
        return "$0.00"


def pct(value):
    try:
        return f"{float(value):+.2f}%"
    except Exception:
        return "0.00%"


def safe_float(value, default=0.0):
    try:
        return float(value)
    except Exception:
        return default


def get_latest_snapshot():
    history = get_equity_history()

    if not history:
        return None

    return history[-1]


def calculate_portfolio_value(cash, positions):
    total = safe_float(cash)

    for symbol, position in positions.items():
        if isinstance(position, dict):
            quantity = safe_float(
                position.get("quantity", position.get("qty", 0))
            )
            price = safe_float(
                position.get(
                    "current_price",
                    position.get(
                        "price",
                        position.get("average_price", 0),
                    ),
                )
            )
        else:
            try:
                quantity = safe_float(position[0])
                price = safe_float(position[1])
            except Exception:
                quantity = 0
                price = 0

        total += quantity * price

    return total


def portfolio_rows(positions):
    rows = []

    for symbol, position in positions.items():
        if isinstance(position, dict):
            quantity = safe_float(
                position.get("quantity", position.get("qty", 0))
            )
            average_price = safe_float(
                position.get("average_price", position.get("avg_price", 0))
            )
            current_price = safe_float(
                position.get(
                    "current_price",
                    position.get("price", average_price),
                )
            )
        else:
            try:
                quantity = safe_float(position[0])
                average_price = safe_float(position[1])
            except Exception:
                quantity = 0
                average_price = 0

            current_price = average_price

        value = quantity * current_price
        pnl = (current_price - average_price) * quantity

        rows.append(
            {
                "Asset": symbol,
                "Quantity": quantity,
                "Avg Price": average_price,
                "Price": current_price,
                "Value": value,
                "P&L": pnl,
            }
        )

    return rows


def load_events():
    conn = get_connection()
    cursor = conn.cursor()

    possible_queries = [
        """
        SELECT *
        FROM events
        ORDER BY id DESC
        LIMIT 50
        """,
    ]

    for query in possible_queries:
        try:
            cursor.execute(query)
            rows = cursor.fetchall()
            columns = [description[0] for description in cursor.description]
            conn.close()

            return pd.DataFrame(rows, columns=columns)
        except Exception:
            pass

    conn.close()
    return pd.DataFrame()


def load_latest_trades():
