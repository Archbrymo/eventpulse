# ============================================================
# AI EVENT FEED
# ============================================================

st.divider()

st.subheader("AI Event Intelligence")

if events:

    for event in reversed(events[-10:]):

        event_id = event[0]
        timestamp = event[1]
        event_text = event[2]
        regime = event[3]
        summary = event[4]

        with st.expander(
            f"{timestamp} — Event #{event_id}"
        ):

            st.write(
                "**Market Event**"
            )

            st.write(
                event_text
            )

            if regime:
                st.write(
                    f"**Market Regime:** "
                    f"{regime}"
                )

            if summary:
                st.write(
                    f"**AI Summary:** "
                    f"{summary}"
                )

else:

    st.info(
        "No AI events recorded yet."
    )


# ============================================================
# TRADE LOG
# ============================================================

st.divider()

st.subheader("AI Trade Log")

if trades:

    trade_rows = []

    for trade in reversed(trades):

        trade_rows.append(
            {
                "Time": trade[1],
                "Ticker": trade[2],
                "Action": trade[3],
                "Quantity": trade[4],
                "Price": trade[5],
                "Value": trade[6],
                "Confidence": trade[7],
                "Reasoning": trade[8],
            }
        )

    trade_df = pd.DataFrame(
        trade_rows
    )

    trade_df[
        "Price"
    ] = trade_df[
        "Price"
    ].map(
        lambda x: f"${x:,.2f}"
    )

    trade_df[
        "Value"
    ] = trade_df[
        "Value"
    ].map(
        lambda x: f"${x:,.2f}"
    )

    trade_df[
        "Confidence"
    ] = trade_df[
        "Confidence"
    ].map(
        lambda x: (
            f"{x:.0%}"
            if pd.notna(x)
            else "-"
        )
    )

    st.dataframe(
        trade_df,
        use_container_width=True,
        hide_index=True,
    )

else:

    st.info(
        "No trades recorded yet."
    )


# ============================================================
# PERFORMANCE STATISTICS
# ============================================================

st.divider()

st.subheader("Performance Statistics")

stat1, stat2, stat3, stat4 = st.columns(
    4
)

with stat1:
    st.metric(
        "Winning Trades",
        performance[
            "winning_trades"
        ],
    )

with stat2:
    st.metric(
        "Losing Trades",
        performance[
            "losing_trades"
        ],
    )

with stat3:
    st.metric(
        "Average Trade",
        money(
            performance[
                "average_trade_pnl"
            ]
        ),
    )

with stat4:
    st.metric(
        "Total Trading P&L",
        money(
            performance[
                "total_trading_pnl"
            ]
        ),
    )
