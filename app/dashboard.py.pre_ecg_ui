# ------------------------------------------------------------

if finalists:

    st.markdown("**10 Evidence Finalists**")

    ticker_cols = st.columns(5)

    for i, candidate in enumerate(finalists[:10]):

        ticker = str(
            candidate.get(
                "ticker",
                candidate.get(
                    "underlying",
                    "—",
                ),
            )
        ).upper()

        score = float(
            candidate.get(
                "evidence_score",
                0,
            )
        )

        change = float(
            candidate.get(
                "change_24h_pct",
                0,
            )
        )

        with ticker_cols[i % 5]:

            st.markdown(
                f"""
                <div style="
                    border:1px solid #dbeafe;
                    border-radius:10px;
                    padding:12px;
                    margin-bottom:10px;
                    background:#f8fbff;
                    text-align:center;
                ">
                    <div style="
                        font-size:18px;
                        font-weight:800;
                        color:#1d4ed8;
                    ">
                        {ticker}
                    </div>
                    <div style="
                        font-size:13px;
                        color:#475569;
                    ">
                        Evidence {score:.0f}
                    </div>
                    <div style="
                        font-size:12px;
                        color:#64748b;
                    ">
                        24h {change:+.2f}%
                    </div>
                </div>
                """,
                unsafe_allow_html=True,
            )

else:

    st.info(
        "Run EventPulse once to populate the live ticker funnel."
    )

