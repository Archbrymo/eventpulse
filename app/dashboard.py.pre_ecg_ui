INITIAL_EQUITY = 100_000.00


def money(value):
    return f"${value:,.2f}"


def pct(value):
    return f"{value:.2f}%"


def load_dashboard_data():
    performance = calculate_performance(
        INITIAL_EQUITY
    )

    trades = get_trades()
    events = get_events()
    equity_history = get_equity_history()
    theses = get_open_theses()

    initial_cash, initial_positions = (
        load_initial_portfolio()
    )

    current_cash, current_positions = (
        load_portfolio()
    )

    return {
        "performance": performance,
        "trades": trades,
        "events": events,
        "equity_history": equity_history,
        "theses": theses,
        "initial_cash": initial_cash,
        "initial_positions": initial_positions,
        "current_cash": current_cash,
        "current_positions": current_positions,
    }


def get_position_table(
    current_positions,
    prices,
):
    rows = []

    for ticker, position in current_positions.items():

        quantity = position["quantity"]
        average_price = position["average_price"]

        current_price = prices.get(
            ticker,
            average_price,
        )

        market_value = (
            quantity * current_price
        )

        cost = (
            quantity * average_price
        )

        pnl = market_value - cost

        if cost > 0:
            pnl_pct = (
                pnl / cost
            ) * 100
        else:
            pnl_pct = 0.0

        rows.append(
            {
                "Ticker": ticker,
                "Shares": quantity,
                "Avg Price": average_price,
                "Current Price": current_price,
                "Market Value": market_value,
                "P&L": pnl,
                "P&L %": pnl_pct,
            }
        )

    return pd.DataFrame(rows)


def get_thesis_table(theses):
    rows = []

    for thesis in theses:

        (
            thesis_id,
            created_at,
            ticker,
            direction,
            confidence,
            thesis_text,
            catalyst,
            bull_case,
            bear_case,
            invalidation_condition,
            expected_horizon,
            entry_price,
            current_price,
            return_pct,
            status,
            resolved_at,
            resolution_reason,
        ) = thesis

        created = pd.to_datetime(
            created_at,
            errors="coerce",
        )

        if pd.isna(created):
            age_days = 0.0
        else:
            age_days = max(
                0.0,
                (
                    pd.Timestamp.utcnow()
                    .tz_localize(None)
                    - created
                ).total_seconds()
                / 86400,
            )

        min_days, max_days = parse_horizon(
            expected_horizon
        )

        if max_days is None:
            max_days = 0

        if max_days > 0:
            horizon_progress = min(
                100.0,
                (age_days / max_days) * 100,
            )
        else:
            horizon_progress = 0.0

        rows.append(
            {
                "ID": thesis_id,
                "Created": created_at,
                "Ticker": ticker,
                "Direction": direction,
                "Confidence": confidence,
                "Status": status,
                "Horizon": expected_horizon or "-",
                "Age (days)": age_days,
                "Progress": horizon_progress,
                "Entry": entry_price,
                "Current": current_price,
                "Return": return_pct,
            }
        )

    return pd.DataFrame(rows)


