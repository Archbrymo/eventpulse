    baseline = pd.DataFrame(
        {
            "Equity": [
                INITIAL_EQUITY
            ]
        },
        index=[
            equity_df.index.min()
            - pd.Timedelta(seconds=1)
        ],
    )

    chart_df = pd.concat(
        [
            baseline,
            equity_df,
        ]
    )

    st.line_chart(
        chart_df,
        y="Equity",
        use_container_width=True,
