# Required: Qwen API key used by app/qwen_client.py and app/news.py
BITGET_QWEN_API_KEY=

# Optional: how often the trading cycle runs when deployed via start.py,
# in seconds. Defaults to 900 (15 minutes) if unset.
TRADING_CYCLE_INTERVAL_SECONDS=900

# Optional: where the SQLite DB and pipeline snapshot are stored.
# Leave unset for local development (defaults to the repo root).
# On Railway, set this to your mounted Volume's path, e.g. /data
EVENTPULSE_DATA_DIR=

